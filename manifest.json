{
    "manifest_version":  3,
    "name":  "YT Ad Mute \u0026 Skip",
    "version":  "2.0.0",
    "description":  "Mutes YouTube while an ad plays, skips it as soon as possible, and restores your original mute state afterward.",
    "permissions":  [
                        "debugger",
                        "storage"
                    ],
    "host_permissions":  [
                             "https://www.youtube.com/*",
                             "https://m.youtube.com/*"
                         ],
    "background":  {
                       "service_worker":  "src/background.js"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://www.youtube.com/*",
                                                "https://m.youtube.com/*"
                                            ],
                                "js":  [
                                           "src/content.js"
                                       ],
                                "run_at":  "document_idle",
                                "all_frames":  false
                            }
                        ],
    "action":  {
                   "default_title":  "YT Ad Mute \u0026 Skip",
                   "default_popup":  "popup/popup.html"
               }
}
